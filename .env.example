# InsightAgent — environment template.
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
#
#   cp .env.example .env
#   # generate a key:  openssl rand -hex 32   (or)   python -c "import secrets;print(secrets.token_hex(32))"

# --- application -------------------------------------------------------------
ENVIRONMENT=development           # development | testing | production
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console                # console for local, json in production

# --- security ----------------------------------------------------------------
# Minimum 32 characters. The application refuses to start in production while this
# is still the placeholder below.
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_TTL_SECONDS=900      # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000 # 30 days
PASSWORD_MIN_LENGTH=12
CORS_ORIGINS=http://localhost:3000

# --- postgres ----------------------------------------------------------------
POSTGRES_USER=insightagent
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=insightagent
POSTGRES_PORT=5432

# Password for the SELECT-only role the text-to-SQL agent uses (Phase 5).
POSTGRES_READONLY_PASSWORD=change-me-readonly-local-only

# Host names: `postgres` inside compose, `localhost` when running the API natively.
DATABASE_URL=postgresql+asyncpg://insightagent:change-me-local-only@postgres:5432/insightagent
DATABASE_URL_READONLY=postgresql+asyncpg://insight_ro:change-me-readonly-local-only@postgres:5432/insightagent

# --- redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# --- frontend ----------------------------------------------------------------
# The browser talks to the Next.js origin, which proxies /api to the backend. This
# keeps the refresh-token cookie same-origin so SameSite=Lax works over plain HTTP
# in development.
FRONTEND_PORT=3000
BACKEND_PORT=8000
BACKEND_INTERNAL_URL=http://backend:8000

# --- bootstrap admin (used by `make seed`, never by the API) -----------------
# Must be a routable address. Reserved TLDs (.local, .localhost, .example,
# .invalid, .test) are rejected by email validation, so an account seeded with one
# could never log in.
ADMIN_EMAIL=admin@insightagent.dev
ADMIN_PASSWORD=change-me-admin-local-only

# --- language models ---------------------------------------------------------
# `fake` is a deterministic test double: the app runs end to end with no API key,
# and the UI banners every response so canned text is never mistaken for a model.
# Switch to openai / anthropic / ollama once the matching credential is set.
# The application refuses to start in production while this is `fake`.
LLM_PROVIDER=fake

# Blank uses the provider's own default
# (openai: gpt-4o-mini, anthropic: claude-haiku-4-5, ollama: qwen2.5:3b-instruct).
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Prior messages replayed as context on each chat turn.
CHAT_HISTORY_LIMIT=20

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# `host.docker.internal` reaches Ollama running on the host from inside compose.
# Ollama binds to 127.0.0.1 by default, which containers cannot reach: set
# OLLAMA_HOST=0.0.0.0 on the host before starting it.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- embeddings --------------------------------------------------------------
# Configured independently of LLM_PROVIDER: the model that answers and the model
# that embeds are separate experiment variables, and are rarely the same vendor.
#
# `fake` is a deterministic hashing bag-of-words vectoriser. It is lexical, not
# semantic, so retrieval works well enough to test the pipeline but no number
# measured against it is a retrieval metric. Refused in production.
#
# `ollama` is the intended default. It needs no API key and keeps torch out of
# the backend image:
#     ollama pull nomic-embed-text
EMBEDDING_PROVIDER=fake

# Blank uses the provider's own default
# (ollama: nomic-embed-text/768d, openai: text-embedding-3-small/1536d).
# Changing the model after ingesting means re-ingesting: vectors are stored per
# model, and a query only ever searches its own model's vectors.
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=120
# Embeddings are cached by (model, content hash). 0 disables the cache.
EMBEDDING_CACHE_TTL_SECONDS=604800

# --- knowledge base ----------------------------------------------------------
# Where uploaded originals are written. In compose this is a named volume shared
# by the backend and the worker; both must agree on the path.
STORAGE_DIR=/var/lib/insightagent/uploads
# 25 MB per file, 250 MB and 100 documents per user. Quotas are a cost control as
# much as a storage one.
MAX_UPLOAD_BYTES=26214400
MAX_DOCUMENTS_PER_USER=100
MAX_STORAGE_BYTES_PER_USER=262144000

# --- chunking & retrieval ----------------------------------------------------
# Part of the retrieval configuration that Phase 4 hashes into `config_hash`, so
# a measured number always traces back to the settings that produced it.
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
RETRIEVAL_TOP_K=8
# Cosine similarity below which a candidate is discarded. This is what lets the
# system answer "the documents do not cover this" instead of citing the
# least-irrelevant chunk it happens to own.
RETRIEVAL_SCORE_FLOOR=0.25
